opam-version: "2.0"
version: "0.1.0"
synopsis: "jax in ocaml"
description: "jax in ocaml"
maintainer: ["nathankarri11@gmail.com"]
authors: ["sixnathan"]
license: "Apache-2.0"
homepage: "https://github.com/sixnathan/ojax"
bug-reports: "https://github.com/sixnathan/ojax/issues"
dev-repo: "git+https://github.com/sixnathan/ojax.git"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.23"}
  "alcotest" {with-test & >= "1.9.0"}
  "yojson" {with-test & >= "2.2.2"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
